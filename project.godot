; Malam Terakhir — Godot 4.3 Project Configuration
; Horror Survival 3D Multiplayer Android Game
config_version=5

[application]

config/name="Malam Terakhir"
config/description="Horror Survival 3D Multiplayer Android Game"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SceneManager="*res://scripts/autoload/scene_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

theme/custom_font_size=24

